# Search Provider Configuration
# Set to 'serpapi' for live web & social search; 'mock' for local offline testing
SEARCH_PROVIDER=mock
SERPAPI_API_KEY=

# Local Face Recognition Models
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
FACE_MATCH_METRIC=cosine
FACE_MATCH_THRESHOLD=0.363000

# Blockchain EVM Configuration (Defaults match local Hardhat node)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY_ADDRESS=
# Default Account 0 private key for local Hardhat node (Do not use on mainnet)
ATTESTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Operational Parameters
RUNS_DIR=runs
MAX_CANDIDATES=20
RETENTION_HOURS=24
